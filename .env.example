# Plantilla de variables de entorno. Copiar a .env y llenar.
#
#   cp .env.example .env
#
# El .env esta en .gitignore y NUNCA entra al repositorio. Una credencial
# versionada anula el criterio completo de gestion de secretos (§2.3.3 y §7.1
# del enunciado), aunque el sistema funcione y aunque se borre despues: git
# conserva el historial.
#
# Este archivo si se versiona, porque no lleva ningun valor.
#
# En produccion estas variables no salen de un archivo: las inyecta Secret
# Manager al contenedor. El codigo no cambia, solo cambia de donde vienen.

# --- Proyecto verdeazul-app -------------------------------------------------
#
# Las cuatro apuntan a la misma base, con usuarios distintos. Esa es toda la
# idea del minimo privilegio: la aplicacion en ejecucion no puede alterar el
# esquema, y el proceso que migra no atiende peticiones.
#
# Terminar todas en  ?sslmode=verify-full
# Neon las da con  ?sslmode=require,  que cifra pero no verifica contra quien
# se esta hablando. verify-full es lo que prometio la Parte 1.
#
# No agregar sslrootcert aqui: la ruta del almacen de certificados la pone el
# codigo con certifi, porque depende de la maquina. El valor especial
# sslrootcert=system no sirve, pide libpq 16 y psycopg[binary] trae la 14.

# Dueno del proyecto. Se usa UNA sola vez, para crear los roles.
# Despues de eso no deberia volver a usarse nunca.
VERDEAZUL_OWNER_URL=

# app_migrate: unico que crea y altera tablas. Solo lo usa db/migrar.py.
VERDEAZUL_MIGRATE_URL=

# app_rw: la aplicacion en ejecucion. SELECT, INSERT, UPDATE.
# Sin DELETE, porque ningun rol de la matriz tiene el permiso E.
VERDEAZUL_DB_URL=

# outbox_rw: el transmisor leyendo la bandeja de salida.
VERDEAZUL_OUTBOX_URL=

# --- Proyecto verdeazul-bitacora --------------------------------------------
#
# Instancia aparte a proposito: es la frontera F6 del diseno. Quien comprometa
# la aplicacion no alcanza el rastro.

# Dueno del proyecto de bitacora. Solo para crear su tabla y su rol.
VERDEAZUL_BITACORA_OWNER_URL=

# log_writer: el transmisor escribiendo. INSERT y nada mas.
# Sin UPDATE ni DELETE, que es lo que hace cierto el "solo anexar" (BI-01).
# Tampoco tiene SELECT: comprometer el transmisor no entrega el historial.
VERDEAZUL_BITACORA_URL=

# log_reader: la API leyendo. SELECT y nada mas.
# Hace falta porque la matriz da L sobre O11 a Direccion General, Direccion de
# Certificacion, Personal Administrativo y Auditor Externo: alguien tiene que
# poder consultar la bitacora, y log_writer no puede leer.
VERDEAZUL_BITACORA_LECTURA_URL=

# --- Contrasenas de los roles -----------------------------------------------
#
# Se usan una sola vez, al correr:  python db/migrar.py claves
# Despues quedan dentro de las cadenas de conexion de arriba.
#
# Generarlas con:
#   .venv/Scripts/python.exe -c "import secrets; [print(secrets.token_urlsafe(24)) for _ in range(5)]"

CLAVE_APP_MIGRATE=
CLAVE_APP_RW=
CLAVE_OUTBOX_RW=
CLAVE_LOG_WRITER=
CLAVE_LOG_READER=

# --- Datos personales -------------------------------------------------------
#
# Llave del HMAC con el que se calcula datos_personales.cedula_busqueda, para
# buscar por cedula sin descifrarla. Tiene que vivir FUERA de la base: si
# estuviera dentro, un volcado entregaria las cedulas, porque nueve digitos se
# recorren enteros en minutos.
#
# Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
LLAVE_BUSQUEDA_CEDULA=

# Llave AES-256-GCM con la que se cifran cedula, telefono y el secreto TOTP
# del segundo factor (LG-05). Distinta de la de arriba: una sirve para buscar
# y esta para leer. Se genera igual, y tiene que dar 32 bytes:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# OJO: tiene que ser LA MISMA que esta en Secret Manager (llave-cifrado-datos).
# Lo que se cifra con una llave no se descifra con otra: si tu .env tiene una
# distinta y cargas datos con db/credenciales_prueba.py, el sistema desplegado
# no los va a poder leer.
LLAVE_CIFRADO_DATOS=
